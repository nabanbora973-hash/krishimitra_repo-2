+await test('closing plus price tamper denied',()=>assertFails(updateDoc(doc(a,'demands/d1'),{status:'closed',closedAt:Date.now(),maxPrice:1})));await test('other user cannot close',()=>assertFails(updateDoc(doc(b,'demands/d1'),{status:'closed',closedAt:Date.now()})));await test('owner closes correctly',()=>assertSucceeds(updateDoc(doc(a,'demands/d1'),{status:'closed',closedAt:Date.now()})));await test('closed demand response denied',()=>assertFails(setDoc(doc(b,'demandResponses/r4'),response)));
+const date=new Date(Date.now()+19800000).toISOString().slice(0,10),day=Math.floor((Date.now()+19800000)/86400000);const report={hasPhoto:false,mandiId:'m1',mandiName:'Test mandi',district:'Dibrugarh',crop:'paddy',modal:2200,min:2100,max:2300,note:'',reporter:'Alice',uid:'alice',date,at:Date.now(),updatedAt:serverTimestamp()};
