-  publish = "src"
-  functions = "netlify/functions"
-
-# Hide the raw function path behind a clean endpoint
-[[redirects]]
-  from = "/api/agmarknet"
-  to = "/.netlify/functions/agmarknet"
-  status = 200
-  force = true
-
